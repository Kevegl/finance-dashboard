[Unit]
Description=Finanz-Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finance
Group=finance
EnvironmentFile=/etc/finance-dashboard.env
WorkingDirectory=/opt/finance-dashboard/app
ExecStart=/usr/bin/python3 /opt/finance-dashboard/app/server.py
Restart=on-failure
RestartSec=3

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/finance-dashboard

[Install]
WantedBy=multi-user.target
