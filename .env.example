# Vorlage für /etc/finance-dashboard.env (install.sh legt die Datei automatisch an).
# Diese Datei enthält nur Platzhalter – echte Werte gehören NICHT ins Repository.

FD_HOST=0.0.0.0
FD_PORT=8080
FD_BASE_CCY=CHF
FD_DATA_DIR=/var/lib/finance-dashboard
FD_PRICE_TTL=14400

# HTTPS (von install.sh erzeugt)
FD_CERT=/etc/finance-dashboard/tls/cert.pem
FD_KEY=/etc/finance-dashboard/tls/key.pem

# FD_DEBUG=1
